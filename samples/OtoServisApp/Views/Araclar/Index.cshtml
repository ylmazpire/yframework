@using YFramework.Validation
@model List<OtoServisApp.Models.Arac>
@{
    ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Araçlar</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Araç</a>
</div>

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

<form method="get" class="mb-3">
    <input type="search" name="ara" value="@ViewData["Ara"]" class="form-control" placeholder="Plaka, marka, model veya müşteri ara..." />
</form>

@if (!Model.Any())
{
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(ViewData["Ara"] as string) ? "Henüz araç eklenmemiş." : "Aramanla eşleşen araç bulunamadı.")
    </p>
}
else
{
    <div class="surface-card">
        <div class="table-responsive">
            <table class="table table-borderless mb-0 align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Plaka</th><th>Araç</th><th>Yıl</th><th>KM</th><th>Müşteri</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@TurkishLicensePlateFormatter.Bicimlendir(a.Plaka)</td>
                            <td>@a.Marka @a.Model</td>
                            <td>@a.ModelYili</td>
                            <td>@a.Kilometre.ToString("N0")</td>
                            <td>
                                @if (a.Musteri is not null)
                                {
                                    <a asp-controller="Musteriler" asp-action="Detay" asp-route-id="@a.MusteriId">@a.Musteri.AdSoyad</a>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Bu aracı silmek istediğine emin misin?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
