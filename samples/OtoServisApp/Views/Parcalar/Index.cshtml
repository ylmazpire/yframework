@using YFramework.Formatting
@model List<OtoServisApp.Models.Parca>
@{
    ViewData["Title"] = "Parça / Stok";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Parça / Stok</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Parça</a>
</div>

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

<form method="get" class="mb-3">
    <input type="search" name="ara" value="@ViewData["Ara"]" class="form-control" placeholder="Stok kodu veya ad ara..." />
</form>

@if (!Model.Any())
{
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(ViewData["Ara"] as string) ? "Henüz parça eklenmemiş." : "Eşleşen parça bulunamadı.")
    </p>
}
else
{
    <div class="surface-card">
        <div class="table-responsive">
            <table class="table table-borderless mb-0 align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Kod</th><th>Ad</th><th class="text-end">Stok</th><th class="text-end">Alış</th><th class="text-end">Satış</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.StokKodu</td>
                            <td>@p.Ad</td>
                            <td class="text-end @(p.StokAdedi == 0 ? "text-danger" : "")">@p.StokAdedi</td>
                            <td class="text-end">@TurkishCurrencyFormatter.Format(p.AlisFiyati)</td>
                            <td class="text-end">@TurkishCurrencyFormatter.Format(p.SatisFiyati)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Hareketler" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Hareketler</a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin mi?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
