@model OtoServisApp.Models.ServisKanaliFormViewModel
@{
    ViewData["Title"] = "Servis Kanalını Düzenle";
}

<h2 class="mb-4">Servis Kanalını Düzenle</h2>

<div class="col-12 col-md-5">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Ad" class="form-label"></label>
            <input asp-for="Ad" class="form-control" />
            <span asp-validation-for="Ad" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Aktif" class="form-check-input" />
            <label asp-for="Aktif" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
