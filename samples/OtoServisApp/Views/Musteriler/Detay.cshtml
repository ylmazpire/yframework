@using YFramework.Validation
@model OtoServisApp.Models.MusteriDetayViewModel
@{
    ViewData["Title"] = Model.Musteri.AdSoyad;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@Model.Musteri.AdSoyad</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Musteri.Id" class="btn btn-outline-secondary">Düzenle</a>
        <a asp-action="Index" class="btn btn-secondary">Geri</a>
    </div>
</div>

<div class="surface-card mb-4">
    <dl class="row mb-0">
        <dt class="col-4 col-sm-3 text-muted">Telefon</dt>
        <dd class="col-8 col-sm-9">@Model.Musteri.Telefon</dd>
        <dt class="col-4 col-sm-3 text-muted">Vergi / T.C. No</dt>
        <dd class="col-8 col-sm-9">@(Model.Musteri.VergiKimlikNo ?? "—")</dd>
        <dt class="col-4 col-sm-3 text-muted">İş emri sayısı</dt>
        <dd class="col-8 col-sm-9">@Model.ToplamIsEmriSayisi</dd>
    </dl>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h4 class="mb-0">Araçlar</h4>
    <a asp-controller="Araclar" asp-action="Create" asp-route-musteriId="@Model.Musteri.Id" class="btn btn-sm btn-primary">+ Araç Ekle</a>
</div>

@if (!Model.Araclar.Any())
{
    <p class="text-muted">Bu müşteriye kayıtlı araç yok.</p>
}
else
{
    <div class="surface-card">
        <div class="table-responsive">
            <table class="table table-borderless mb-0 align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Plaka</th><th>Araç</th><th>Yıl</th><th>KM</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Araclar)
                    {
                        <tr>
                            <td>@TurkishLicensePlateFormatter.Bicimlendir(a.Plaka)</td>
                            <td>@a.Marka @a.Model</td>
                            <td>@a.ModelYili</td>
                            <td>@a.Kilometre.ToString("N0")</td>
                            <td class="text-end"><a asp-controller="Araclar" asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
