@using System.Globalization
@using YFramework.Formatting
@model KuaforApp.Models.GunSonuViewModel
@{
    ViewData["Title"] = "Gün Sonu Özeti";
    var oncekiGun = Model.Tarih.AddDays(-1);
    var sonrakiGun = Model.Tarih.AddDays(1);
    var trTr = CultureInfo.GetCultureInfo("tr-TR");

    string DurumBadgeClass(KuaforApp.Models.RandevuDurumu durum) => durum switch
    {
        KuaforApp.Models.RandevuDurumu.Planlandi => "bg-primary",
        KuaforApp.Models.RandevuDurumu.Tamamlandi => "bg-success",
        _ => "bg-secondary"
    };

    string DurumMetni(KuaforApp.Models.RandevuDurumu durum) => durum switch
    {
        KuaforApp.Models.RandevuDurumu.Planlandi => "Planlandı",
        KuaforApp.Models.RandevuDurumu.Tamamlandi => "Tamamlandı",
        _ => "İptal Edildi"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Gün Sonu Özeti</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Randevulara Dön</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" asp-action="GunSonu" asp-route-tarih="@oncekiGun.ToString("yyyy-MM-dd")">← <span class="d-none d-sm-inline">Önceki Gün</span></a>
    <h5 class="mb-0 text-center" style="font-size: 0.95rem;">@Model.Tarih.ToString("dd.MM.yyyy dddd", trTr)</h5>
    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" asp-action="GunSonu" asp-route-tarih="@sonrakiGun.ToString("yyyy-MM-dd")"><span class="d-none d-sm-inline">Sonraki Gün</span> →</a>
</div>

<div class="hero-card mb-4">
    <div class="hero-label">Bugünkü Kazanç (tamamlanan randevular)</div>
    <div class="hero-value">@TurkishCurrencyFormatter.Format(Model.ToplamKazanc)</div>
    <div class="hero-sub">
        <span class="positive">@Model.TamamlananSayisi tamamlandı</span>
        &nbsp;·&nbsp;
        <span>@Model.PlanliKalanSayisi planlı kaldı</span>
        &nbsp;·&nbsp;
        <span class="negative">@Model.IptalSayisi iptal</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value">@Model.ToplamRandevu</div>
            <div class="stat-label">Toplam Randevu</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value text-success">@Model.TamamlananSayisi</div>
            <div class="stat-label">Tamamlandı</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value text-danger">@Model.IptalSayisi</div>
            <div class="stat-label">İptal</div>
        </div>
    </div>
</div>

@if (Model.PlanliKalanSayisi > 0)
{
    <div class="alert alert-danger">
        Bu günde hâlâ <strong>@Model.PlanliKalanSayisi</strong> tane "Planlandı" durumunda randevu var —
        gün sonu yapmadan önce bunları "Tamamlandı" ya da "İptal Et" olarak işaretlemeyi unutma.
    </div>
}

@if (!Model.Randevular.Any())
{
    <p class="text-muted">Bu gün için randevu yok.</p>
}
else
{
    <div class="surface-card">
        <h6 class="mb-3">Gün İçindeki Randevular</h6>
        @foreach (var randevu in Model.Randevular)
        {
            <div class="list-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="list-card-title">@randevu.Musteri?.AdSoyad</div>
                    <div class="list-card-subtitle">@randevu.Hizmet?.Ad · @randevu.BaslangicZamani.ToString("HH:mm")</div>
                </div>
                <span class="badge @DurumBadgeClass(randevu.Durum)">@DurumMetni(randevu.Durum)</span>
            </div>
        }
    </div>
}
