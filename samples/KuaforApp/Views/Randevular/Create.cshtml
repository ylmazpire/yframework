@model KuaforApp.Models.RandevuCreateViewModel
@{
    ViewData["Title"] = "Yeni Randevu";
}

<h2 class="mb-4">Yeni Randevu</h2>

<div class="col-12 col-md-6">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="MusteriId" class="form-label">Mevcut Müşteri</label>
            <select asp-for="MusteriId" asp-items="Model.Musteriler" class="form-select" id="musteriSelect">
                <option value="">-- Mevcut müşteri seçin --</option>
            </select>
        </div>

        <div class="text-center text-muted small my-2">— veya —</div>

        <div class="mb-3">
            <label asp-for="YeniMusteriAdi" class="form-label">Yeni Müşteri Adı Soyadı</label>
            <input asp-for="YeniMusteriAdi" class="form-control" placeholder="Örn. Ayşe Yılmaz" />
        </div>
        <div class="mb-3">
            <label asp-for="YeniMusteriTelefon" class="form-label">Telefon (opsiyonel)</label>
            <input asp-for="YeniMusteriTelefon" class="form-control" data-tr-phone inputmode="numeric" placeholder="0 533 598 32 12" />
            <span asp-validation-for="YeniMusteriTelefon" class="text-danger"></span>
        </div>

        <hr />

        <div class="mb-3">
            <label asp-for="HizmetId" class="form-label">Hizmet</label>
            <select asp-for="HizmetId" asp-items="Model.Hizmetler" class="form-select">
                <option value="">-- Hizmet seçin --</option>
            </select>
            <span asp-validation-for="HizmetId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BaslangicZamani" class="form-label"></label>
            <input asp-for="BaslangicZamani" class="form-control" type="datetime-local" />
            <span asp-validation-for="BaslangicZamani" class="text-danger"></span>
        </div>
        @if (Model.PersonelSecimiVar)
        {
            <div class="mb-3">
                <label asp-for="PersonelId" class="form-label">Personel</label>
                <select asp-for="PersonelId" asp-items="Model.Personeller" class="form-select">
                    <option value="">-- Personel seçin --</option>
                </select>
            </div>
        }
        <div class="mb-3">
            <label asp-for="Not" class="form-label">Not (opsiyonel)</label>
            <textarea asp-for="Not" class="form-control" rows="2" placeholder="Örn. Saç boyası formülü: 6.3 + 20 vol"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
    <style>
        /* Select2'yi koyu temaya uydur */
        .select2-container--default .select2-selection--single {
            background-color: var(--surface-elevated);
            border-color: var(--border);
            height: calc(1.5em + 0.75rem + 2px);
            display: flex;
            align-items: center;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered { color: var(--text); }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: calc(1.5em + 0.75rem); }
        .select2-dropdown { background-color: var(--surface-elevated); border-color: var(--border); }
        .select2-search--dropdown .select2-search__field { background-color: var(--bg); color: var(--text); border-color: var(--border); }
        .select2-results__option { color: var(--text); }
        .select2-container--default .select2-results__option--highlighted[aria-selected] { background-color: var(--accent); }
        .select2-container--default .select2-results__option[aria-selected=true] { background-color: var(--surface); }
    </style>
    <script>
        $(function () {
            $('#musteriSelect').select2({
                placeholder: 'Müşteri adı yazarak ara...',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function () { return 'Sonuç bulunamadı'; },
                    searching: function () { return 'Aranıyor...'; }
                }
            });
        });
    </script>
}
