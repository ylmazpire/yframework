@model KuaforApp.Models.MuhasebeRaporViewModel
@{
    ViewData["Title"] = "Muhasebe";
    var aylar = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    var oncekiAy = new DateTime(Model.Yil, Model.Ay, 1).AddMonths(-1);
    var sonrakiAy = new DateTime(Model.Yil, Model.Ay, 1).AddMonths(1);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Muhasebe</h2>
    <div class="d-flex gap-2">
        <a asp-controller="MuhasebeKategoriler" asp-action="Index" class="btn btn-outline-secondary">Kategoriler</a>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Kayıt</a>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-yil="@oncekiAy.Year" asp-route-ay="@oncekiAy.Month">← @aylar[oncekiAy.Month]</a>
    <h5 class="mb-0">@aylar[Model.Ay] @Model.Yil</h5>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-yil="@sonrakiAy.Year" asp-route-ay="@sonrakiAy.Month">@aylar[sonrakiAy.Month] →</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value text-success">@Model.Ozet.ToplamGelir.ToString("C")</div>
            <div class="stat-label">Gelir</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value text-danger">@Model.Ozet.ToplamGider.ToString("C")</div>
            <div class="stat-label">Gider</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card">
            <div class="stat-value">@Model.Ozet.Net.ToString("C")</div>
            <div class="stat-label">Net</div>
        </div>
    </div>
</div>

@if (!Model.Kayitlar.Any())
{
    <p class="text-muted">Bu ayda kayıt yok.</p>
}
else
{
    <!-- Mobil: kart görünümü -->
    <div class="d-lg-none">
        @foreach (var kayit in Model.Kayitlar)
        {
            <div class="list-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="list-card-title">@kayit.Kategori?.Ad</div>
                    <div class="list-card-subtitle">@kayit.Aciklama · @kayit.Tarih.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="fw-semibold @(kayit.GelirMi ? "text-success" : "text-danger")">
                    @(kayit.GelirMi ? "+" : "-")@kayit.Tutar.ToString("C")
                </div>
            </div>
        }
    </div>

    <!-- Masaüstü: tablo görünümü -->
    <div class="d-none d-lg-block surface-card">
        <table class="table table-borderless mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Tarih</th>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th class="text-end">Tutar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kayit in Model.Kayitlar)
                {
                    <tr>
                        <td>@kayit.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>@kayit.Kategori?.Ad</td>
                        <td>@kayit.Aciklama</td>
                        <td class="text-end @(kayit.GelirMi ? "text-success" : "text-danger")">
                            @(kayit.GelirMi ? "+" : "-")@kayit.Tutar.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
