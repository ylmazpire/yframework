@model List<KuaforApp.Models.Personel>
@{
    ViewData["Title"] = "Personel";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Personel</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Personel</a>
</div>

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Henüz personel eklenmemiş. Tek başına çalışıyorsan personel eklemene gerek yok — randevular otomatik olarak işletme geneline göre yönetilir.</p>
}

<div class="d-lg-none">
    @foreach (var personel in Model)
    {
        <div class="list-card d-flex justify-content-between align-items-center">
            <div class="list-card-title">@personel.AdSoyad</div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@personel.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@personel.Id" method="post" onsubmit="return confirm('Bu personeli silmek istediğine emin misin?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </div>
        </div>
    }
</div>

<div class="d-none d-lg-block surface-card">
    <table class="table table-borderless mb-0 align-middle">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th>Ad Soyad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var personel in Model)
            {
                <tr>
                    <td>@personel.AdSoyad</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@personel.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@personel.Id" method="post" class="d-inline" onsubmit="return confirm('Bu personeli silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
