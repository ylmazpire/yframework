@using YFramework.Validation
@model List<KuaforApp.Models.Musteri>
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Müşteriler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Müşteri</a>
</div>

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

<form method="get" class="mb-3">
    <input type="search" name="ara" value="@ViewData["Ara"]" class="form-control" placeholder="İsim veya telefon ara..." />
</form>

@if (!Model.Any())
{
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(ViewData["Ara"] as string) ? "Henüz müşteri eklenmemiş." : "Aramanla eşleşen müşteri bulunamadı.")
    </p>
}

<!-- Mobil: kart görünümü -->
<div class="d-lg-none">
    @foreach (var musteri in Model)
    {
        <div class="list-card">
            <a asp-action="Detay" asp-route-id="@musteri.Id" style="color: inherit; text-decoration: none;">
                <div class="list-card-title">@musteri.AdSoyad</div>
                <div class="list-card-subtitle">@musteri.Telefon</div>
            </a>
            <div class="d-flex gap-2 flex-wrap mt-2">
                @{ var e164 = TurkishPhoneNumberFormatter.ToE164(musteri.Telefon); }
                @if (e164 is not null)
                {
                    <a href="tel:@e164" class="btn btn-sm btn-outline-secondary" title="Ara">📞</a>
                    <a href="https://wa.me/@e164.TrimStart('+')" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="WhatsApp">💬</a>
                }
                <a asp-action="Edit" asp-route-id="@musteri.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@musteri.Id" method="post" onsubmit="return confirm('Bu müşteriyi silmek istediğine emin misin?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </div>
        </div>
    }
</div>

<!-- Masaüstü: tablo görünümü -->
<div class="d-none d-lg-block surface-card">
    <table class="table table-borderless mb-0 align-middle">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th>Ad Soyad</th>
                <th>Telefon</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var musteri in Model)
            {
                <tr>
                    <td><a asp-action="Detay" asp-route-id="@musteri.Id">@musteri.AdSoyad</a></td>
                    <td>@musteri.Telefon</td>
                    <td class="text-end">
                        @{ var e164Masaustu = TurkishPhoneNumberFormatter.ToE164(musteri.Telefon); }
                        @if (e164Masaustu is not null)
                        {
                            <a href="tel:@e164Masaustu" class="btn btn-sm btn-outline-secondary" title="Ara">📞</a>
                            <a href="https://wa.me/@e164Masaustu.TrimStart('+')" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="WhatsApp">💬</a>
                        }
                        <a asp-action="Edit" asp-route-id="@musteri.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@musteri.Id" method="post" class="d-inline" onsubmit="return confirm('Bu müşteriyi silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
