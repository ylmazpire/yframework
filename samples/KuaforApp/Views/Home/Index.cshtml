@model KuaforApp.Models.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var net = Model.BuAyOzeti.Net;
    var netClass = net >= 0 ? "positive" : "negative";
    var aylar = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
}

<div class="hero-card mb-4">
    <div class="hero-label">@aylar[DateTime.Today.Month] Ayı Net Kazanç</div>
    <div class="hero-value">@net.ToString("C")</div>
    <div class="hero-sub">
        <span class="positive">+@Model.BuAyOzeti.ToplamGelir.ToString("C")</span>
        &nbsp;·&nbsp;
        <span class="negative">-@Model.BuAyOzeti.ToplamGider.ToString("C")</span>
    </div>
</div>

<div class="quick-nav mb-4">
    <a asp-controller="Randevular" asp-action="Index">
        <span class="icon">📅</span>Randevular
    </a>
    <a asp-controller="Musteriler" asp-action="Index">
        <span class="icon">👥</span>Müşteriler
    </a>
    <a asp-controller="Hizmetler" asp-action="Index">
        <span class="icon">💈</span>Hizmetler
    </a>
    <a asp-controller="Muhasebe" asp-action="Index">
        <span class="icon">💰</span>Muhasebe
    </a>
    <a asp-controller="Randevular" asp-action="GunSonu">
        <span class="icon">📊</span>Gün Sonu
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value">@Model.BugunkuRandevuSayisi</div>
            <div class="stat-label">Bugünkü Randevu</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value">@Model.BuHaftakiRandevuSayisi</div>
            <div class="stat-label">Bu Hafta</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value">@Model.ToplamMusteriSayisi</div>
            <div class="stat-label">Toplam Müşteri</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value">@Model.ToplamHizmetSayisi</div>
            <div class="stat-label">Toplam Hizmet</div>
        </div>
    </div>
</div>

<div class="surface-card">
    <h6 class="mb-3">Bugünkü Randevular</h6>
    @if (!Model.BugunkuRandevular.Any())
    {
        <p class="text-muted mb-0">Bugün için planlanmış randevu yok.</p>
    }
    else
    {
        @foreach (var randevu in Model.BugunkuRandevular)
        {
            <div class="list-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="list-card-title">@randevu.Musteri?.AdSoyad</div>
                    <div class="list-card-subtitle">@randevu.Hizmet?.Ad</div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@randevu.BaslangicZamani.ToString("HH:mm")</div>
                    <div class="list-card-subtitle">@randevu.BitisZamani.ToString("HH:mm")</div>
                </div>
            </div>
        }
    }
</div>
