@model List<KuaforApp.Models.MuhasebeKategorisi>
@{
    ViewData["Title"] = "Muhasebe Kategorileri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Muhasebe Kategorileri</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kategori</a>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <div class="surface-card">
            <h6 class="text-success mb-3">Gelir Kategorileri</h6>
            @foreach (var kategori in Model.Where(k => k.Tur == KuaforApp.Models.IslemTuru.Gelir))
            {
                <div class="list-card">@kategori.Ad</div>
            }
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="surface-card">
            <h6 class="text-danger mb-3">Gider Kategorileri</h6>
            @foreach (var kategori in Model.Where(k => k.Tur == KuaforApp.Models.IslemTuru.Gider))
            {
                <div class="list-card">@kategori.Ad</div>
            }
        </div>
    </div>
</div>
