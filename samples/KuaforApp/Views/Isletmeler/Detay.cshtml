@model KuaforApp.Models.IsletmeDetayViewModel
@{
    ViewData["Title"] = Model.Isletme.Ad;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@Model.Isletme.Ad</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← İşletmeler</a>
</div>

@if (TempData["Basari"] is string basari)
{
    <div class="alert alert-success">@basari</div>
}

<div class="surface-card">
    <h6 class="mb-3">Yetkili Hesaplar</h6>
    @if (!Model.Kullanicilar.Any())
    {
        <p class="text-muted mb-0">Bu işletmeye bağlı bir hesap yok.</p>
    }
    else
    {
        @foreach (var kullanici in Model.Kullanicilar)
        {
            <div class="list-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="list-card-title">@kullanici.AdSoyad</div>
                    <div class="list-card-subtitle">@kullanici.Email</div>
                </div>
                <a asp-action="SifreSifirla" asp-route-kullaniciId="@kullanici.Id" class="btn btn-sm btn-outline-secondary">Şifre Sıfırla</a>
            </div>
        }
    }
</div>
