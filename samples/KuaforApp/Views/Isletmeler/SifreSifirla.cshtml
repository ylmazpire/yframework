@model KuaforApp.Models.SifreSifirlaViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<h2 class="mb-4">Şifre Sıfırla</h2>
<p class="text-muted"><strong>@Model.Email</strong> için yeni bir şifre belirle.</p>

<div class="col-12 col-md-6">
    <form asp-action="SifreSifirla" method="post">
        <input type="hidden" asp-for="KullaniciId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="YeniSifre" class="form-label"></label>
            <input asp-for="YeniSifre" class="form-control" />
            <span asp-validation-for="YeniSifre" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
