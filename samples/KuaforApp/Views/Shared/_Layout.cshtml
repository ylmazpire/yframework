@{
    bool isAdmin = User.IsInRole("Admin");
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - KuaforApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KuaforApp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar">
                <a class="brand" asp-controller="Home" asp-action="Index">✂ KuaforApp</a>
                <nav class="nav flex-column">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">🏠 Ana Sayfa</a>
                    @if (isAdmin)
                    {
                        <a class="nav-link @(currentController == "Randevular" ? "active" : "")" asp-controller="Randevular" asp-action="Index">📅 Randevular</a>
                        <a class="nav-link @(currentController == "Musteriler" ? "active" : "")" asp-controller="Musteriler" asp-action="Index">👥 Müşteriler</a>
                        <a class="nav-link @(currentController == "Hizmetler" ? "active" : "")" asp-controller="Hizmetler" asp-action="Index">💈 Hizmetler</a>
                    }
                </nav>
                <div class="mt-auto pt-3">
                    <div class="text-muted small mb-2 px-2">@User.Identity!.Name</div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-link nav-link w-100 text-start px-2">🚪 Çıkış Yap</button>
                    </form>
                </div>
            </aside>
        }
        <div class="app-main">
            <header class="app-topbar">
                <a class="brand-mobile" asp-controller="Home" asp-action="Index">✂ KuaforApp</a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div>
                        <a class="btn btn-sm btn-outline-primary me-2" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                        <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                    </div>
                }
                else
                {
                    <span class="text-muted small d-none d-sm-inline">@User.Identity!.Name</span>
                }
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true && isAdmin)
    {
        <nav class="app-bottom-nav">
            <a class="@(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <span class="icon">🏠</span>Ana Sayfa
            </a>
            <a class="@(currentController == "Randevular" ? "active" : "")" asp-controller="Randevular" asp-action="Index">
                <span class="icon">📅</span>Randevular
            </a>
            <a class="@(currentController == "Musteriler" ? "active" : "")" asp-controller="Musteriler" asp-action="Index">
                <span class="icon">👥</span>Müşteriler
            </a>
            <a class="@(currentController == "Hizmetler" ? "active" : "")" asp-controller="Hizmetler" asp-action="Index">
                <span class="icon">💈</span>Hizmetler
            </a>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
