@model List<KuaforApp.Models.Hizmet>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Hizmetler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Hizmet</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz hizmet eklenmemiş.</p>
}

<!-- Mobil: kart görünümü -->
<div class="d-lg-none">
    @foreach (var hizmet in Model)
    {
        <div class="list-card d-flex justify-content-between align-items-center">
            <div>
                <div class="list-card-title">@hizmet.Ad</div>
                <div class="list-card-subtitle">@hizmet.SureDakika dk</div>
            </div>
            <div class="fw-semibold">@hizmet.Fiyat.ToString("C")</div>
        </div>
    }
</div>

<!-- Masaüstü: tablo görünümü -->
<div class="d-none d-lg-block surface-card">
    <table class="table table-borderless mb-0">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th>Ad</th>
                <th>Süre (dk)</th>
                <th>Fiyat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hizmet in Model)
            {
                <tr>
                    <td>@hizmet.Ad</td>
                    <td>@hizmet.SureDakika</td>
                    <td>@hizmet.Fiyat.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
