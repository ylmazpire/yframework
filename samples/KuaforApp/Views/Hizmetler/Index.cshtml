@using YFramework.Formatting
@model List<KuaforApp.Models.Hizmet>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Hizmetler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Hizmet</a>
</div>

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Henüz hizmet eklenmemiş.</p>
}

<!-- Mobil: kart görünümü -->
<div class="d-lg-none">
    @foreach (var hizmet in Model)
    {
        <div class="list-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <div class="list-card-title">@hizmet.Ad</div>
                    <div class="list-card-subtitle">@hizmet.SureDakika dk</div>
                </div>
                <div class="fw-semibold">@TurkishCurrencyFormatter.Format(hizmet.Fiyat)</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@hizmet.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@hizmet.Id" method="post" onsubmit="return confirm('Bu hizmeti silmek istediğine emin misin?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </div>
        </div>
    }
</div>

<!-- Masaüstü: tablo görünümü -->
<div class="d-none d-lg-block surface-card">
    <table class="table table-borderless mb-0 align-middle">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th>Ad</th>
                <th>Süre (dk)</th>
                <th>Fiyat</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hizmet in Model)
            {
                <tr>
                    <td>@hizmet.Ad</td>
                    <td>@hizmet.SureDakika</td>
                    <td>@TurkishCurrencyFormatter.Format(hizmet.Fiyat)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@hizmet.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@hizmet.Id" method="post" class="d-inline" onsubmit="return confirm('Bu hizmeti silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
