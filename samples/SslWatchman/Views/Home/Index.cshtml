@model PanoViewModel
@{
    ViewData["Title"] = "Pano";
}

<div class="page-head">
    <div>
        <h1>Pano</h1>
        <div class="page-sub">@Model.Toplam alan adı izleniyor@(Model.Kritik + Model.Uyari > 0 ? $" · {Model.Kritik + Model.Uyari} dikkat gerektiriyor" : "")</div>
    </div>
    <div class="page-actions">
        <a asp-controller="Domainler" asp-action="Create" class="btn btn-primary">+ Domain ekle</a>
    </div>
</div>

<div class="stat-strip">
    <div class="stat">
        <div class="stat-label">Kritik</div>
        <div class="stat-value @(Model.Kritik > 0 ? "crit" : "")">@Model.Kritik</div>
    </div>
    <div class="stat">
        <div class="stat-label">Uyarı</div>
        <div class="stat-value @(Model.Uyari > 0 ? "warn" : "")">@Model.Uyari</div>
    </div>
    <div class="stat">
        <div class="stat-label">Sağlıklı</div>
        <div class="stat-value @(Model.Saglikli > 0 ? "ok" : "")">@Model.Saglikli</div>
    </div>
    <div class="stat">
        <div class="stat-label">Kontrolsüz</div>
        <div class="stat-value">@Model.Kontrolsuz</div>
    </div>
</div>

<div class="section-head">İzlenen alan adları <span class="count">@Model.Toplam</span></div>

@if (Model.Toplam == 0)
{
    <div class="panel panel-pad muted">
        Henüz alan adı eklenmemiş. <a asp-controller="Domainler" asp-action="Create">İlk domaini ekle →</a>
    </div>
}
else
{
    <div class="panel">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Alan adı</th><th>Durum</th><th class="num">Kalan</th><th>Sağlayıcı</th><th>Son kontrol</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Domainler)
                    {
                        <tr class="@(d.Aktif ? "" : "opacity-50")">
                            <td>
                                <a class="mono fw-semibold" asp-controller="Domainler" asp-action="Detay" asp-route-id="@d.Id">@d.TargetAdi</a>
                                @if (!d.Aktif) { <span class="small muted"> · pasif</span> }
                            </td>
                            <td><partial name="_Durum" model="d.SonSonuc" /></td>
                            <td class="num mono @(d.KalanGun is < 7 ? "text-danger fw-semibold" : "")">
                                @(d.KalanGun is null ? "—" : $"{d.KalanGun}g")
                            </td>
                            <td class="muted">@(d.Issuer ?? "—")</td>
                            <td class="muted small">@(d.SonKontrolUtc is null ? "—" : d.SonKontrolUtc.Value.ToLocalTime().ToString("dd.MM HH:mm"))</td>
                            <td class="text-end">
                                <a asp-controller="Domainler" asp-action="Detay" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Aç →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
