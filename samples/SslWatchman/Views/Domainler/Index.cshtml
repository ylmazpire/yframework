@model List<IzlenenDomain>
@{
    ViewData["Title"] = "Domainler";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">Domainler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Domain Ekle</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz domain eklenmemiş.</p>
}
else
{
    <div class="surface-card">
        <div class="table-responsive">
            <table class="table table-borderless mb-0 align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase"><th>Alan adı</th><th>Durum</th><th>Kalan</th><th>Aktif</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold"><a asp-action="Detay" asp-route-id="@d.Id">@d.TargetAdi</a></td>
                            <td><partial name="_Durum" model="d.SonSonuc" /></td>
                            <td>@(d.KalanGun is null ? "—" : $"{d.KalanGun} gün")</td>
                            <td>@(d.Aktif ? "evet" : "hayır")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('Bu domain ve geçmişi silinsin mi?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
