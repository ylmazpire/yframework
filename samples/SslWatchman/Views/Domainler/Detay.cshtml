@model DomainDetayViewModel
@{
    ViewData["Title"] = Model.Domain.TargetAdi;
    var d = Model.Domain;
}

<div class="page-head">
    <div>
        <h1 class="mono">@d.TargetAdi</h1>
        <div class="page-sub"><partial name="_Durum" model="d.SonSonuc" /> <span class="muted">@d.SonKontrolMesaji</span></div>
    </div>
    <div class="page-actions">
        <form asp-action="SimdiKontrolEt" asp-route-id="@d.Id" method="post">
            <button type="submit" class="btn btn-primary">Şimdi kontrol et</button>
        </form>
        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-outline-secondary">Düzenle</a>
        <a asp-action="Index" class="btn btn-secondary">← Geri</a>
    </div>
</div>

@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-info">@bilgi</div>
}

<div class="panel panel-pad mb-4">
    <dl class="kv">
        <dt>Sertifika bitişi</dt>
        <dd>
            @(d.SertifikaBitisUtc is null ? "—" : d.SertifikaBitisUtc.Value.ToLocalTime().ToString("dd.MM.yyyy"))
            @if (d.KalanGun is not null)
            {
                <span class="muted">· @d.KalanGun gün kaldı</span>
            }
        </dd>
        <dt>Sağlayıcı</dt>
        <dd>@(d.Issuer ?? "—")</dd>
        <dt>Port</dt>
        <dd class="mono">@d.Port</dd>
        <dt>Son kontrol</dt>
        <dd class="muted">@(d.SonKontrolUtc is null ? "—" : d.SonKontrolUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</dd>
        <dt>Aktif</dt>
        <dd>@(d.Aktif ? "evet" : "hayır")</dd>
        @if (!string.IsNullOrWhiteSpace(d.Not))
        {
            <dt>Not</dt>
            <dd>@d.Not</dd>
        }
    </dl>
</div>

<div class="section-head">Kontrol geçmişi <span class="count">@Model.Gecmis.Count</span></div>
@if (!Model.Gecmis.Any())
{
    <div class="panel panel-pad muted">Henüz kontrol kaydı yok.</div>
}
else
{
    <div class="panel">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Zaman</th><th>Sonuç</th><th>Mesaj</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Gecmis)
                    {
                        <tr>
                            <td class="muted small text-nowrap mono">@c.ZamanUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td><partial name="_Durum" model="c.Sonuc" /></td>
                            <td>@c.Mesaj</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
