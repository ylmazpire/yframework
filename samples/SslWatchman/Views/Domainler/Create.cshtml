@model DomainFormViewModel
@{
    ViewData["Title"] = "Domain ekle";
}
<div class="page-head">
    <div><h1>Domain ekle</h1></div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-secondary">← Geri</a></div>
</div>

<div class="panel panel-pad" style="max-width:620px">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Ekle ve kontrol et</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
