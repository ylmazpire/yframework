@model CheckOutcome?
@{
    var (etiket, cls) = Model switch
    {
        CheckOutcome.Ok => ("Sağlıklı", "ok"),
        CheckOutcome.Warning => ("Uyarı", "warn"),
        CheckOutcome.Error => ("Erişilemedi", "err"),
        CheckOutcome.Critical => ("Kritik", "crit"),
        _ => ("Kontrol edilmedi", "")
    };
}
<span class="pill @cls">@etiket</span>
